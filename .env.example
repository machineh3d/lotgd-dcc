# ============================================================================
# DUNGEON CRAWLER CARL — DOCKER ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in your own strong credentials.
# NEVER commit your real .env file to Git!
# ============================================================================
LOTGD_BASE_IMAGE=ghcr.io/nb-core/lotgd:latest
WEB_CONTAINER_NAME=your-web-container
DB_CONTAINER_NAME=your-db-container
APP_PORT=8080
TZ=UTC

DB_NAME=YOUR_DB_NAME
DB_USER=YOUR_DB_USER
DB_PASS=YOUR_DB_PASSWORD
DB_ROOT_PASS=YOUR_DB_ROOT_PASSWORD
