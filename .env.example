# ============================================================================
# DUNGEON CRAWLER CARL — DOCKER ENVIRONMENT TEMPLATE
# Copy this file to .env and replace DB_PASS / DB_ROOT_PASS with REAL secrets
# (NB-Core's entrypoint rejects placeholder passwords!):
#   openssl rand -base64 24 | tr -dc 'A-Za-z0-9' | head -c 24
# NEVER commit your real .env file to Git!
# ============================================================================
LOTGD_BASE_IMAGE=ghcr.io/nb-core/lotgd:latest
WEB_CONTAINER_NAME=your-web-container
DB_CONTAINER_NAME=your-db-container
APP_PORT=8080
TZ=UTC

# Set to 1 for initial installer.php setup; automatically locked once /var/lib/lotgd/installation-complete is created
LOTGD_INSTALL_ENABLED=1

DB_NAME=YOUR_DB_NAME
DB_USER=YOUR_DB_USER
DB_PASS=YOUR_DB_PASSWORD
DB_ROOT_PASS=YOUR_DB_ROOT_PASSWORD
